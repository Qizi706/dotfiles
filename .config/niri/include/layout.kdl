// Base layout. DMS may override generated values such as gaps and radius.
layout {
    background-color "transparent"
    gaps 5
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    border {
        off
        width 20

        // Pink-lavender -> sky blue, shared across the workspace so neighboring
        // windows pick up different parts of one continuous color transition.
        // Gradients take precedence over the opaque colors generated by DMS.
        active-gradient from="#f5c2e7c7" to="#89dcebc7" angle=45 relative-to="workspace-view" in="oklch shorter hue"

        // A quiet blue-gray -> lavender-gray transition for inactive windows.
        inactive-gradient from="#6c708066" to="#9399b266" angle=45 relative-to="workspace-view" in="oklab"

        // Coral -> warm gold keeps urgent windows clear without a harsh red ring.
        urgent-gradient from="#f38ba8e6" to="#f9e2afe6" angle=45 relative-to="workspace-view" in="oklch shorter hue"
    }

    focus-ring {
        on
        width 2
        active-gradient from="#f5c2e7ff" to="#89dcebc7" angle=45 relative-to="workspace-view" in="oklch shorter hue"
        inactive-gradient from="#6c708066" to="#9399b266" angle=45 relative-to="workspace-view" in="oklab"
        urgent-gradient from="#f38ba8e6" to="#f9e2afe6" angle=45 relative-to="workspace-view" in="oklch shorter hue"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000070"
    }

    // gaps 5 + struts 10 approximates Hyprland gaps_out=15.
    struts {
        left 10
        right 10
        top 10
        bottom 10
    }
}

overview {
    workspace-shadow { off; }
}

prefer-no-csd
