#!/usr/bin/env bash

set -Eeuo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_dir"

failed=0

forbidden='^(etc/|\.mozilla/|private/|\.config/(dconf|nvim|obs-studio|pulse)/)'
index_files=$(
    git ls-files --cached --others --exclude-standard |
        while IFS= read -r path; do
            [[ -e "$path" || -L "$path" ]] && printf '%s\n' "$path"
        done
)
if grep -Eq "$forbidden" <<<"$index_files"; then
    echo 'audit-secrets: forbidden state/credential paths are staged:' >&2
    grep -E "$forbidden" <<<"$index_files" >&2
    failed=1
fi

unexpected_identity=$(
    grep -E '^(\.ssh|\.gnupg)/' <<<"$index_files" |
        grep -Ev '^(\.ssh/config|\.gnupg/common\.conf)$' || true
)
if [[ -n "$unexpected_identity" ]]; then
    echo 'audit-secrets: unexpected SSH/GnuPG files are tracked:' >&2
    printf '%s\n' "$unexpected_identity" >&2
    failed=1
fi

# Report file names only so a secret is never echoed into a terminal or CI log.
token_pattern='BEGIN (OPENSSH|RSA|EC|DSA|PGP) PRIVATE KEY|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{24,}'
for scope in index worktree; do
    grep_args=(-I -l -E "$token_pattern")
    [[ $scope == index ]] && grep_args=(--cached "${grep_args[@]}")
    [[ $scope == worktree ]] && grep_args=(--untracked "${grep_args[@]}")
    mapfile -t suspicious < <(git grep "${grep_args[@]}" -- . ':!scripts/audit-secrets' || true)
    if ((${#suspicious[@]})); then
        printf 'audit-secrets: possible credential material in %s:\n' "$scope" >&2
        printf '  %s\n' "${suspicious[@]}" >&2
        failed=1
    fi
done

if ((failed)); then
    exit 1
fi

echo 'audit-secrets: no tracked credential paths or obvious private tokens found'
